---
import Layout from "../layouts/Layout.astro";
import TarjetaTaller from "../components/TarjetaTaller.astro";
---

<Layout
	title="Inicio | Espacio Cultural"
	description="Descubre nuestros talleres creativos."
>
	<section class="hero">
		<div class="hero-text">
			<span class="eyebrow">Cultura · Arte · Comunidad</span>
			<h1>Un espacio para dar vida a tus ideas.</h1>
			<p>
				En Espacio Cultural creemos que todos tenemos algo que crear.
				Ven a descubrir nuevas habilidades, conocer personas y expresar
				tu creatividad.
			</p>
			<a class="button" href="/talleres">Descubre los talleres</a>
		</div>

		<img
			class="hero-image"
			src="/img/hero.svg"
			alt="Ilustración artística de Espacio Cultural"
		/>
	</section>

	<section class="section">
		<div class="section-heading">
			<span class="eyebrow">Explora y aprende</span>
			<h2>Nuestros talleres destacados</h2>
			<p>Encuentra una actividad que te inspire.</p>
		</div>

		<div class="workshop-grid">
			<TarjetaTaller
				nombre="Fotografía"
				descripcion="Aprende a capturar momentos y contar historias a través de imágenes."
				imagen="/img/fotografia.svg"
				etiqueta="Arte visual"
			/>

			<TarjetaTaller
				nombre="Cerámica"
				descripcion="Descubre el trabajo con arcilla y crea piezas únicas con tus manos."
				imagen="/img/ceramica.svg"
				etiqueta="Arte manual"
			/>

			<TarjetaTaller
				nombre="Escritura creativa"
				descripcion="Desarrolla tu imaginación y transforma tus ideas en historias."
				imagen="/img/escritura.svg"
				etiqueta="Literatura"
			/>
		</div>

		<div class="center">
			<a class="button button-outline" href="/talleres">
				Ver todos los talleres
			</a>
		</div>
	</section>
</Layout>
